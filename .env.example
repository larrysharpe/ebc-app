# PostgreSQL (required)
DATABASE_URL=postgresql://ebc:ebc_dev@localhost:5432/ebc_dev

# Auth (Phase 0+)
AUTH_SECRET=replace-with-a-random-32-character-secret

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cursor agent (header prompt + ministry suggested plans)
# Create a key at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Optional: use cloud agents in deployed environments (GitHub repo URL)
# CURSOR_CLOUD_REPO=https://github.com/your-org/ebc-app

# OpenAI text-to-speech for event form voice coach (shimmer)
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Cron auth for background jobs (Vercel Cron sends Authorization: Bearer $CRON_SECRET)
# CRON_SECRET=replace-with-a-random-secret

# Email notifications (optional — until set, messages stay queued in NotificationOutbox)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="EBC APP <noreply@ebenezerbc.org>"

# Web / app push (optional — until set, push stays queued)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:office@ebenezerbc.org

# SMS / text notifications via Twilio (optional — until set, texts stay queued)
# Phone numbers come from Person.phone matched to User.email
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
